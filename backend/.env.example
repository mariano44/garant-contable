APP_NAME="Garant Contable"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=garant
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Firma de los JWT. Se genera con: php artisan jwt:secret
JWT_SECRET=

# ---------------------------------------------------------------------------
# Correo. En local basta con el driver "log": los correos se escriben en
# storage/logs/laravel.log en vez de enviarse.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# PayPal. Sin esto la pantalla de planes se ve, pero el webhook de alta de
# suscripcion no puede confirmar nada.
# ---------------------------------------------------------------------------
PAYPALCLIENTIDDEV=
PAYPALCLIENTSECRETDEV=
PAYPALCLIENTID=
PAYPALCLIENTSECRET=

# ---------------------------------------------------------------------------
# PAC de timbrado (SOAP). Dos juegos de credenciales:
#   P*      -> ambiente de pruebas, se usa si el usuario trae periodoprueba=1
#   sin P   -> produccion
# El timbrado real no corre sin un PAC contratado y un CSD valido.
# ---------------------------------------------------------------------------
PUSUARIO=
PPASSWORD=
PIDEQUIPO=
PWSDL=

USUARIO=
PASSWORD=
IDEQUIPO=
WSDL=

# Clave de webservice del CRM que da de alta la cuenta tras el pago. Opcional.
CRM_ACCESS_KEY=
